# Copy to .env.local and fill in. NEVER commit .env.local.
# Find this in Cloudinary Console > Settings > API Keys ("API environment variable")
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Optional AI add-ons. Enable each in Console > Settings > Add-ons, or leave blank to skip.
CLD_MODERATION=aws_rek
CLD_TAGGING=google_tagging
